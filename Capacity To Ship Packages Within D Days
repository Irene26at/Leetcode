class Solution:
    def shipWithinDays(self, weights: List[int], days: int):
        left = max(weights)
        right = sum(weights)

        def can_ship(capacity):
            requiredays = 1
            currentload = 0

            for weight in weights:
                if currentload + weight > capacity:
                    requiredays += 1
                    currentload = weight
                else:
                    currentload += weight

            return requiredays <= days

        result = right

        while left <= right:
            mid = left + (right - left) // 2

            if can_ship(mid):
                result = mid
                right = mid - 1
            else:
                left = mid + 1

        return result
